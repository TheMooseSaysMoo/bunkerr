{
  "name": "bunkerr",
  "version": "0.1.0",
  "private": true,
  "description": "Household emergency-prep tracker: inventory, expiry alerts, Meshtastic health, gardens, docs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c green,yellow \"tsx watch server/src/index.ts\" \"vite\"",
    "build": "vite build && tsc -p server",
    "start": "node server/dist/index.js",
    "cli": "tsx server/src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p server --noEmit && tsc -p web --noEmit"
  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@node-rs/argon2": "^2.2.2",
    "@zxing/browser": "^0.2.1",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.5",
    "marked": "^18.1.0",
    "mqtt": "^5.16.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^7.0.13",
    "preact": "^11.0.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
