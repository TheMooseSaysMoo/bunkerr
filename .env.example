# Bunkerr configuration. Copy to .env (never commit it) and edit.
# ./setup.sh does this for you and fills in INTERNAL_SECRET.
# A single server needs only the first block; everything else is optional.

# ---- basics -------------------------------------------------------------------
NODE_ENV=production
# The address people open in their browser. https:// turns on secure cookies.
# For a quick LAN test use e.g. http://192.168.1.10:8787
PUBLIC_URL=https://bunkerr.example.com
TZ=America/New_York
# Random secret: encrypts the SMTP password at rest and protects /api/internal/*.
# Generate with: openssl rand -hex 32   (keep it; changing it means re-entering the SMTP password)
INTERNAL_SECRET=
# Host port the app listens on. "8787" = all interfaces; "127.0.0.1:8787" = only a local reverse proxy.
BUNKERR_BIND=8787

# ---- receipt / shelf photo import (optional) -----------------------------------
# An Anthropic API key enables "receipt / shelf photo" on the Add page.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ---- barcode lookups (docs/10-barcodes.md) -------------------------------------
# Offline USDA + Open Food Facts copy in data/barcodes.db (~140 MB), refreshed nightly when due.
BARCODE_MIRROR=on
BARCODE_COUNTRIES=en:united-states
BARCODE_ONLINE=on
UPCITEMDB=on

# ---- notifications --------------------------------------------------------------
# Email (SMTP), ntfy and Discord are all set up inside the app (Settings); nothing needed here.
# Optional: a router that accepts Home Assistant-style webhooks ({source,title,body,priority}),
# as a base URL or a full URL ending in the webhook path. Most people leave this empty.
WEBHOOK_ROUTER_URL=

# ---- Meshtastic (optional; empty = mesh ingest off, docs/05-meshtastic-mqtt.md) ---
# Your own MQTT broker that your Meshtastic gateways publish to: mqtt://, mqtts:// or wss://
MQTT_URL=
MQTT_USERNAME=bunkerr
MQTT_PASSWORD=
# Topic filter(s), comma-separated, e.g. msh/US/MyTown/#   (only .../json/... topics are read)
MQTT_TOPICS=msh/#
# Accept a self-signed certificate on your own mqtts:// broker
#MQTT_TLS_INSECURE=false

# ---- external family portal (optional, docs/08-onboarding-a-household.md) ------
# Bearer token a portal uses to create accounts via /api/hub/accounts. Empty = off.
HUB_TOKEN=

# ---- failover pair (optional, docs/04-failover.md) ------------------------------
# Name shown in the status line, and this instance's role.
NODE_NAME=primary
BUNKERR_ROLE=primary
# The other instance over a private network (LAN, VPN, Tailscale). Empty = single server.
PEER_URL=
# How often the standby copies the primary's database (minutes).
SYNC_MINUTES=15
# Extra bind for the peer's checks and sync, e.g. 10.0.0.2:8787 (a private-network address).
#BUNKERR_BIND_TAILNET=127.0.0.1:18787

# ---- standby only: the watchdog that promotes it and switches DNS ---------------
#COMPOSE_PROFILES=standby
#PRIMARY_NODE=primary
#PUBLIC_HOST=bunkerr.example.com
# Cloudflare API token with Zone → DNS → Edit for the zone, and the zone's id
#CF_API_TOKEN=
#CF_ZONE_ID=
# Cloudflare tunnel ids the hostname's CNAME points at: normally the primary's, after failover the standby's
#PRIMARY_TUNNEL_ID=
#STANDBY_TUNNEL_ID=
# Where failover/failback notices go (any or all): an ntfy topic URL and/or a Discord webhook
#OPS_NTFY_URL=https://ntfy.sh/your-random-ops-topic
#OPS_NTFY_TOKEN=
#OPS_DISCORD_WEBHOOK=
#CHECK_SECONDS=30
#FAIL_THRESHOLD=6

# ---- advanced -------------------------------------------------------------------
# Force secure cookies on/off (default: on when PUBLIC_URL is https).
#COOKIE_SECURE=
# Turn off background jobs (digests, alerts, backups) on this instance.
#SCHEDULER_ENABLED=true
